# Скопировать: cp .local/sync-prod.env.example .local/sync-prod.env
# Настройки rsync prod → local (файл в .gitignore не коммитится)

# SSH (алиас redbox-db в ~/.ssh/config или ключ на root@178.250.157.140)
PROD_SSH=redbox-db

# Корень сайта на сервере
PROD_PATH=/var/www/almamed_su_usr/data/www/almamed.su/

# Хост для nginx proxy медиа в local dev (start-dev.sh подставляет в nginx.conf)
PROD_MEDIA_HOST=almamed.su

# Опционально: другой rsync (macOS Homebrew)
# RSYNC_BIN=/opt/homebrew/bin/rsync
