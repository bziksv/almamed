msgstr "Всегда открывать страницу редактирования товара"

msgid "Please enter a valid plugin parameters"
msgstr "Пожалуйста, введите допустимые параметры плагина"

msgid "Show the text «Edit» at the edit button"
msgstr "Показывать текст «Редактировать» на кнопке редактирования"

msgid "Answers to questions"
msgstr "Ответы на вопросы"

msgid "A fixed button<br>“Quick access”"
msgstr "Фиксированная кнопка<br>«Быстрый доступ»"

msgid "Quick access"
msgstr "«Быстрый доступ»"

msgid "Settings"
msgstr "Настройки"

msgid "Plugins"
msgstr "Плагины"

msgid "Qrders"
msgstr "Заказы"

msgid "Products"
msgstr "Товары"

msgid "Customers"
msgstr "Покупатели"

