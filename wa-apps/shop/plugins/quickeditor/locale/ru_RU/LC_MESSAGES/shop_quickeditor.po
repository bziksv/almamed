msgstr "Рядом с кнопкой «В корзину»"

msgid "Location of «Edit» button on a product page"
msgstr "Положение кнопки «Редактировать» на странице товара"

msgid "Show «Edit» button on a category page"
msgstr "Показать кнопку «Редактировать» на странице категории"

msgid "Automatic plugin output works only on the product page."
msgstr "Автоматический вывод плагина работает только на странице товара."

msgid "On the left side of the page"
msgstr "На левой стороне страницы"

msgid "On the right side of the page"
msgstr "На правой стороне страницы"

msgid "Hidden"
msgstr "Скрыть"

msgid "Edit product"
msgstr "Редактировать товар"

msgid "Edit category"
msgstr "Редактировать категорию"

