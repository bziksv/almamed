msgid "Instructions for using the plugin"
msgstr "Инструкция по использованию плагина"

msgid "Paste the plugin code into the template. Embed code is presented below (only works in «Store» application templates)"
msgstr "Вставьте этот код плагина в шаблоне. Код для вставки представлен ниже (работает только в шаблонах приложения «Магазин»)"

msgid "Enable plugin"
msgstr "Включить плагин"

msgid "Embed code for template (only for app «Shop»)"
msgstr "Код для вставки в шаблон приложения «Магазин» "

msgid "By default the plugin is disabled."
msgstr "По умолчанию плагин отключен."

msgid "First of all, set mark «Enable plugin»."
msgstr "Прежде всего, установите галочку «Включить плагин»."

msgid "where ID is product ID."
msgstr "где ID это уникальный идентификатор товара."

msgid "You can put the code other else application template, in a place where you want."
msgstr "Код плагина, можно помещать в любые другие файлы шаблона."

msgid "But only in «Shop» app."
msgstr "Но только в шаблонах приложения «Магазин»."

msgid "Save"
msgstr "Сохранить"

msgid "Edit"
msgstr "Редактировать"

msgid "Saved"
msgstr "Сохранено"

msgid "Quick products editor"
msgstr "Быстрый редактор товаров"

msgid "Save and update"
msgstr "Сохранить и обновить"

msgid "Show product descriptions on «Basics» tab"
msgstr "Показывать описание товара во вкладке «Общие сведения»"

