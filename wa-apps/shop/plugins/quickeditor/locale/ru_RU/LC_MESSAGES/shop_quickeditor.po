msgstr "Открывает окно редактирования из фронтенда"

msgid "The plugin automatically adding fixed edit button on: information pages, product pages, categories pages"
msgstr "Плагин автоматически добавляет фиксированную кнопку редактирования на: информационные страницы, страницы товаров, страницы категорий"

msgid "To display additional edit button for each product in category, insert a plugin code in list-thumbs.html as shown below"
msgstr "Чтобы использовать дополнительную кнопку редактирования для каждого продукта в категории, вставьте код плагина в list-thumbs.html, как показано ниже"

msgid "Use multi-storefront settings"
msgstr "Использовать мульти-витринные настройки"

msgid "Enable separate plugin settings for each storefront"
msgstr "Включить отдельные настройки плагина для каждой витрины"

msgid "Storefront"
msgstr "Витрина"

msgid "Select storefront for saving current settings"
msgstr "Выберите витрину для сохранения текущих настроек"

msgid "Reset settings"
msgstr "Сброс настроек"

msgid "Reset settings to default"
msgstr "Сброс к настройкам по умолчанию"

msgid "Storefront not found"
msgstr "Витрина не найдена"

msgid "Open setting tab"
msgstr "Открыть вкладку настроек"

msgid "For opening specific setting tab press \"Shift\" button, then click \"Edit\""
msgstr "Для открытия указанной вкладки настроек, нажмите кнопку «Shift», затем нажмите «Изменить»"

