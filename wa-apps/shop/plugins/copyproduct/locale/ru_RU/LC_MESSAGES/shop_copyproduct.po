#: /wa-apps/shop/plugins/copyproduct/lib/config/plugin.php:8
msgid "Product duplication"
msgstr "Копирование товаров"

#: /wa-apps/shop/plugins/copyproduct/lib/config/plugin.php:9
msgid "Allows to create product duplicates"
msgstr "Позволяет делать копии товаров"

#: /wa-apps/shop/plugins/copyproduct/lib/shopCopyproduct.plugin.php:7
msgid "Duplicate"
msgstr "Создать копию"

msgid "Not to copy product images"
msgstr "Не копировать изображения"

msgid "If checked, then product images will not be copied"
msgstr "Если галочка поставлена, то изображения товаров копироваться не будут"

msgid "Button \"Duplicate\" on the product page"
msgstr "Кнопка \"Создать копию\" в карточке товара"

msgid "Hide copy"
msgstr "Делать копии скрытыми"

msgid "If checked, then duplicates will be hidden"
msgstr "Если галочка поставлена, то для копий товаров будет выставляться статус скрытый товар"

msgid "Clear sku name (if only one sku)"
msgstr "Удалять название вариации, если у товара только один артикул"

msgid "If checked and the product has only one sku, then sku name will be cleared"
msgstr "Если галочка поставлена и у товара, только одна вариации, то при копировании название артикула будет удалено (решает проблему кривого импорта)"

msgid "Copy related products"
msgstr "Копировать рекомендуемые товары"

msgid "If checked, then related products will be linked to the copy"
msgstr "Если галочка поставлена, то все рекомендуемые товары, указанные вручную, будут привязаны к новому товару"

msgid "Clear sku"
msgstr "Удалять артикул"

msgid "If checked sku will be cleared"
msgstr "Если галочка поставлена, то у копии будет пустой артикул"